import { Head, Link } from '@inertiajs/react';
import {
    CheckCircle2,
    ExternalLink,
    ShieldCheck,
} from 'lucide-react';
import AccountLayout from '../components/account-layout';
import { Card } from '../components/ui';

type Props = {
    security: {
        two_factor_enabled: boolean;
        two_factor_confirmed: boolean;
        email_verified: boolean;
        password_updated_at?: string | null;
    };
};

export default function SecurityIndex({ security }: Props) {
    return (
        <AccountLayout section="security">
            <Head title="Paramètres de sécurité" />

            <div className="space-y-6">
                <Card
                    title="Authentification à deux facteurs"
                    description="Ajoutez une protection supplémentaire à votre compte."
                >
                    <div className="flex flex-col gap-4 rounded-xl border border-white/5 bg-black/10 p-5 sm:flex-row sm:items-center sm:justify-between">
                        <div className="flex items-center gap-3">
                            <span
                                className={`grid h-11 w-11 place-items-center rounded-xl ${
                                    security.two_factor_enabled
                                        ? 'bg-emerald-500/10 text-emerald-300'
                                        : 'bg-amber-500/10 text-amber-300'
                                }`}
                            >
                                <ShieldCheck className="h-5 w-5" />
                            </span>

                            <div>
                                <p className="text-sm font-black">
                                    {security.two_factor_enabled
                                        ? security.two_factor_confirmed
                                            ? 'Double authentification activée et confirmée'
                                            : 'Double authentification en attente de confirmation'
                                        : 'Double authentification désactivée'}
                                </p>

                                <p className="mt-1 text-xs text-slate-500">
                                    La gestion du QR code, de la confirmation et des codes de récupération se fait dans les réglages de sécurité.
                                </p>
                            </div>
                        </div>

                        <Link
                            href="/settings/security"
                            className="inline-flex h-10 items-center gap-2 rounded-xl bg-violet-500/10 px-4 text-sm font-black text-violet-200"
                        >
                            <ExternalLink className="h-4 w-4" />
                            Gérer la double authentification
                        </Link>
                    </div>
                </Card>

                <Card title="État du compte">
                    <div className="grid gap-3 md:grid-cols-2">
                        <Status
                            label="Adresse courriel vérifiée"
                            ok={security.email_verified}
                        />
                        <Status
                            label="Mot de passe configuré"
                            ok
                        />
                    </div>
                </Card>
            </div>
        </AccountLayout>
    );
}

function Status({
    label,
    ok,
}: {
    label: string;
    ok: boolean;
}) {
    return (
        <div className="flex items-center gap-3 rounded-xl border border-white/5 bg-black/10 p-4">
            <CheckCircle2
                className={`h-5 w-5 ${
                    ok ? 'text-emerald-300' : 'text-amber-300'
                }`}
            />
            <span className="text-sm font-black">{label}</span>
        </div>
    );
}
