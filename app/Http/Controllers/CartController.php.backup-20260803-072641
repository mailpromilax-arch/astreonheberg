<?php

namespace App\Http\Controllers;

use App\Models\ProductPlan;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Inertia\Inertia;
use Inertia\Response;

class CartController extends Controller
{
    public function index(Request $request): Response
    {
        $cart = $this->cart($request);
        $options = $this->options($request);

        $plans = ProductPlan::query()
            ->with([
                'product:id,product_category_id,name,slug',
                'product.category:id,name,slug',
            ])
            ->whereIn('id', array_keys($cart))
            ->get()
            ->keyBy('id');

        $items = collect($cart)
            ->map(function (int $quantity, int|string $planId) use ($plans, $options): ?array {
                $plan = $plans->get((int) $planId);

                if (! $plan || ! $plan->isAvailable()) {
                    return null;
                }

                return [
                    'plan_id' => $plan->id,
                    'quantity' => $quantity,
                    'name' => $plan->name,
                    'sku' => $plan->sku,
                    'price_monthly_cents' => $plan->price_monthly_cents,
                    'setup_fee_cents' => $plan->setup_fee_cents,
                    'line_monthly_cents' => $plan->price_monthly_cents * $quantity,
                    'line_setup_cents' => $plan->setup_fee_cents * $quantity,
                    'product' => [
                        'name' => $plan->product?->name,
                        'slug' => $plan->product?->slug,
                    ],
                    'category' => [
                        'name' => $plan->product?->category?->name,
                    ],
                    'options' => $options[(int) $planId] ?? [],
                ];
            })
            ->filter()
            ->values();

        $validCart = $items
            ->mapWithKeys(fn (array $item): array => [
                $item['plan_id'] => $item['quantity'],
            ])
            ->all();

        if ($validCart !== $cart) {
            $request->session()->put('cart', $validCart);
        }

        return Inertia::render('store/cart', [
            'items' => $items,
            'summary' => [
                'quantity' => $items->sum('quantity'),
                'monthly_cents' => $items->sum('line_monthly_cents'),
                'setup_cents' => $items->sum('line_setup_cents'),
                'due_today_cents' => $items->sum('line_monthly_cents')
                    + $items->sum('line_setup_cents'),
            ],
        ]);
    }

    public function store(
        Request $request,
        ProductPlan $plan,
    ): RedirectResponse {
        abort_unless($plan->isAvailable(), 404);

        $validated = $request->validate([
            'quantity' => ['nullable', 'integer', 'min:1', 'max:10'],
            'ark_edition' => [
                'nullable',
                'string',
                'in:survival-evolved,survival-ascended',
            ],
        ]);

        $quantity = (int) ($validated['quantity'] ?? 1);
        $cart = $this->cart($request);
        $currentQuantity = (int) ($cart[$plan->id] ?? 0);
        $newQuantity = min($currentQuantity + $quantity, 10);

        if (
            $plan->stock_tracking
            && $plan->stock_quantity !== null
            && $newQuantity > $plan->stock_quantity
        ) {
            return back()->with(
                'error',
                'La quantité demandée dépasse le stock disponible.',
            );
        }

        $cart[$plan->id] = $newQuantity;
        $request->session()->put('cart', $cart);

        $isArk = str_contains(
            mb_strtolower((string) $plan->product?->name),
            'ark',
        ) || str_contains(
            mb_strtolower((string) $plan->product?->slug),
            'ark',
        );

        if ($isArk) {
            $edition = $validated['ark_edition'] ?? null;

            if (! in_array(
                $edition,
                ['survival-evolved', 'survival-ascended'],
                true,
            )) {
                return back()->with(
                    'error',
                    'Choisissez ARK: Survival Evolved ou Survival Ascended.',
                );
            }

            $options = $this->options($request);
            $options[$plan->id] = [
                'ark_edition' => $edition,
                'ark_egg_id' => $edition === 'survival-ascended'
                    ? 22
                    : 23,
            ];
            $request->session()->put('cart_options', $options);
        }

        return to_route('cart.index')
            ->with('success', 'L’offre a été ajoutée au panier.');
    }

    public function update(
        Request $request,
        ProductPlan $plan,
    ): RedirectResponse {
        $validated = $request->validate([
            'quantity' => ['required', 'integer', 'min:1', 'max:10'],
        ]);

        $cart = $this->cart($request);

        if (! array_key_exists($plan->id, $cart)) {
            return back()->with('error', 'Cette offre n’est pas dans le panier.');
        }

        $quantity = (int) $validated['quantity'];

        if (
            $plan->stock_tracking
            && $plan->stock_quantity !== null
            && $quantity > $plan->stock_quantity
        ) {
            return back()->with(
                'error',
                'La quantité demandée dépasse le stock disponible.',
            );
        }

        $cart[$plan->id] = $quantity;
        $request->session()->put('cart', $cart);

        return back()->with('success', 'Le panier a été mis à jour.');
    }

    public function destroy(
        Request $request,
        ProductPlan $plan,
    ): RedirectResponse {
        $cart = $this->cart($request);

        unset($cart[$plan->id]);

        $request->session()->put('cart', $cart);

        $options = $this->options($request);
        unset($options[$plan->id]);
        $request->session()->put('cart_options', $options);

        return back()->with('success', 'L’offre a été retirée du panier.');
    }

    public function clear(Request $request): RedirectResponse
    {
        $request->session()->forget([
            'cart',
            'cart_options',
        ]);

        return back()->with('success', 'Le panier a été vidé.');
    }

    /**
     * @return array<int|string, int>
     */
    private function cart(Request $request): array
    {
        $cart = $request->session()->get('cart', []);

        return is_array($cart) ? $cart : [];
    }

    /**
     * @return array<int|string, array<string, mixed>>
     */
    private function options(Request $request): array
    {
        $options = $request->session()->get('cart_options', []);

        return is_array($options) ? $options : [];
    }
}
