<?php

declare(strict_types=1);

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Models\User;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Hash;
use Illuminate\Support\Facades\Schema;
use Illuminate\Validation\Rule;
use Inertia\Inertia;
use Inertia\Response;
use Illuminate\Support\Str;
use Throwable;

final class UserController extends Controller
{
    public function index(Request $request): Response
    {
        $search = trim((string) $request->string('search'));
        $role = trim((string) $request->string('role'));
        $status = trim((string) $request->string('status'));

        $query = DB::table('users');

        if ($search !== '') {
            $query->where(function ($builder) use ($search): void {
                $builder
                    ->where('name', 'like', "%{$search}%")
                    ->orWhere('email', 'like', "%{$search}%");

                foreach (['company_name', 'phone', 'customer_number'] as $column) {
                    if (Schema::hasColumn('users', $column)) {
                        $builder->orWhere($column, 'like', "%{$search}%");
                    }
                }
            });
        }

        if ($role !== '' && Schema::hasColumn('users', 'role')) {
            $query->where('role', $role);
        }

        if ($status !== '' && Schema::hasColumn('users', 'status')) {
            $query->where('status', $status);
        }

        $columns = ['id', 'name', 'email', 'created_at', 'updated_at'];

        foreach ([
            'role',
            'status',
            'company_name',
            'phone',
            'email_verified_at',
            'two_factor_confirmed_at',
            'last_login_at',
        ] as $column) {
            if (Schema::hasColumn('users', $column)) {
                $columns[] = $column;
            }
        }

        $users = $query
            ->select($columns)
            ->latest('created_at')
            ->paginate(20)
            ->withQueryString()
            ->through(fn (object $user): array => [
                'id' => $user->id,
                'name' => $user->name,
                'email' => $user->email,
                'role' => $user->role ?? 'client',
                'status' => $user->status ?? 'active',
                'company' => $user->company_name ?? null,
                'phone' => $user->phone ?? null,
                'email_verified_at' => $user->email_verified_at ?? null,
                'two_factor_enabled' => ! empty($user->two_factor_confirmed_at),
                'last_login_at' => $user->last_login_at ?? null,
                'created_at' => $user->created_at,
                'updated_at' => $user->updated_at,
            ]);

        $counts = [
            'total' => DB::table('users')->count(),
            'clients' => Schema::hasColumn('users', 'role')
                ? DB::table('users')->where('role', 'client')->count()
                : DB::table('users')->count(),
            'admins' => Schema::hasColumn('users', 'role')
                ? DB::table('users')->whereIn('role', ['admin', 'super_admin'])->count()
                : 0,
            'suspended' => Schema::hasColumn('users', 'status')
                ? DB::table('users')->whereIn('status', ['suspended', 'disabled', 'banned'])->count()
                : 0,
        ];

        return Inertia::render('admin/users/index', [
            'users' => $users,
            'filters' => [
                'search' => $search,
                'role' => $role,
                'status' => $status,
            ],
            'counts' => $counts,
            'capabilities' => [
                'has_status' => Schema::hasColumn('users', 'status'),
                'has_role' => Schema::hasColumn('users', 'role'),
                'has_two_factor' => Schema::hasColumn('users', 'two_factor_secret'),
            ],
        ]);
    }

    public function show(int $user): Response
    {
        $record = DB::table('users')->where('id', $user)->first();

        abort_if($record === null, 404);

        $services = $this->latestRowsForUser(
            'services',
            $user,
            ['id', 'name', 'status', 'expires_at', 'created_at'],
            8,
        );

        $orders = $this->latestRowsForUser(
            'orders',
            $user,
            ['id', 'reference', 'status', 'total_cents', 'created_at'],
            8,
        );

        $payments = $this->latestRowsForUser(
            'payments',
            $user,
            ['id', 'status', 'amount_cents', 'provider', 'created_at'],
            8,
        );

        $tickets = $this->latestRowsForUser(
            'tickets',
            $user,
            ['id', 'subject', 'title', 'status', 'priority', 'created_at'],
            8,
        );

        $userData = [];
        foreach ((array) $record as $key => $value) {
            if (in_array($key, [
                'password',
                'remember_token',
                'two_factor_secret',
                'two_factor_recovery_codes',
            ], true)) {
                continue;
            }

            $userData[$key] = $value;
        }

        $stripePaymentMethods = [];
        $stripeError = null;

        try {
            $billableUser = User::query()->findOrFail($user);

            if (
                method_exists($billableUser, 'hasStripeId')
                && $billableUser->hasStripeId()
            ) {
                $stripePaymentMethods = collect(
                    $billableUser->paymentMethods(),
                )->map(fn ($method): array => [
                    'id' => $method->id,
                    'brand' => $method->card?->brand ?? 'card',
                    'last4' => $method->card?->last4 ?? '----',
                    'exp_month' => $method->card?->exp_month ?? null,
                    'exp_year' => $method->card?->exp_year ?? null,
                ])->values()->all();
            }
        } catch (Throwable $exception) {
            report($exception);
            $stripeError = 'Impossible de charger les moyens de paiement Stripe.';
        }

        return Inertia::render('admin/users/show', [
            'user' => $userData,
            'temporary_password' => session('temporary_password'),
            'stripe_payment_methods' => $stripePaymentMethods,
            'stripe_error' => $stripeError,
            'services' => $services,
            'orders' => $orders,
            'payments' => $payments,
            'tickets' => $tickets,
            'stats' => [
                'services' => count($services),
                'orders' => count($orders),
                'payments' => count($payments),
                'tickets' => count($tickets),
            ],
            'capabilities' => [
                'has_status' => Schema::hasColumn('users', 'status'),
                'has_role' => Schema::hasColumn('users', 'role'),
                'has_two_factor' => Schema::hasColumn('users', 'two_factor_secret'),
            ],
        ]);
    }

    public function update(Request $request, int $user): RedirectResponse
    {
        abort_unless(DB::table('users')->where('id', $user)->exists(), 404);

        $rules = [
            'name' => ['required', 'string', 'max:255'],
            'email' => [
                'required',
                'email',
                'max:255',
                Rule::unique('users', 'email')->ignore($user),
            ],
        ];

        if (Schema::hasColumn('users', 'role')) {
            $rules['role'] = ['required', Rule::in([
                'client',
                'support',
                'admin',
                'super_admin',
            ])];
        }

        if (Schema::hasColumn('users', 'status')) {
            $rules['status'] = ['required', Rule::in([
                'active',
                'suspended',
                'disabled',
                'banned',
            ])];
        }

        foreach (['first_name', 'last_name', 'company_name', 'phone', 'address_line_1', 'address_line_2', 'postal_code', 'city', 'region', 'country', 'locale'] as $field) {
            if (Schema::hasColumn('users', $field)) {
                $rules[$field] = ['nullable', 'string', 'max:255'];
            }
        }

        $validated = $request->validate($rules);
        $validated['updated_at'] = now();

        DB::table('users')->where('id', $user)->update($validated);

        $this->log(
            $request,
            'user.updated',
            "Compte client #{$user} modifié",
            $user,
        );

        return back()->with('success', 'Compte client mis à jour.');
    }

    public function temporaryPassword(Request $request, int $user): RedirectResponse
    {
        abort_unless(DB::table('users')->where('id', $user)->exists(), 404);

        $password = Str::password(
            length: 16,
            letters: true,
            numbers: true,
            symbols: true,
        );

        DB::table('users')->where('id', $user)->update([
            'password' => Hash::make($password),
            'updated_at' => now(),
        ]);

        $this->log(
            $request,
            'user.temporary_password',
            "Mot de passe temporaire généré pour le client #{$user}",
            $user,
        );

        return back()->with('temporary_password', $password);
    }

    public function disableTwoFactor(Request $request, int $user): RedirectResponse
    {
        abort_unless(DB::table('users')->where('id', $user)->exists(), 404);

        $updates = ['updated_at' => now()];

        foreach ([
            'two_factor_secret',
            'two_factor_recovery_codes',
            'two_factor_confirmed_at',
        ] as $column) {
            if (Schema::hasColumn('users', $column)) {
                $updates[$column] = null;
            }
        }

        DB::table('users')->where('id', $user)->update($updates);

        $this->log(
            $request,
            'user.two_factor_disabled',
            "Double authentification désactivée pour le client #{$user}",
            $user,
        );

        return back()->with('success', 'Double authentification désactivée.');
    }

    public function deletePaymentMethod(
        Request $request,
        int $user,
        string $paymentMethod,
    ): RedirectResponse {
        $billableUser = User::query()->findOrFail($user);

        try {
            abort_unless(
                method_exists($billableUser, 'deletePaymentMethod'),
                501,
            );

            $billableUser->deletePaymentMethod($paymentMethod);
        } catch (Throwable $exception) {
            report($exception);

            return back()->with(
                'error',
                'Suppression impossible. Ce moyen de paiement est peut-être utilisé par un abonnement actif.',
            );
        }

        $this->log(
            $request,
            'user.payment_method_deleted',
            "Moyen de paiement Stripe supprimé pour le client #{$user}",
            $user,
        );

        return back()->with('success', 'Moyen de paiement supprimé.');
    }

    public function suspend(Request $request, int $user): RedirectResponse
    {
        abort_unless(DB::table('users')->where('id', $user)->exists(), 404);

        if (Schema::hasColumn('users', 'status')) {
            DB::table('users')->where('id', $user)->update([
                'status' => 'suspended',
                'updated_at' => now(),
            ]);
        }

        $this->log(
            $request,
            'user.suspended',
            "Compte client #{$user} suspendu",
            $user,
        );

        return back()->with('success', 'Compte suspendu.');
    }

    public function activate(Request $request, int $user): RedirectResponse
    {
        abort_unless(DB::table('users')->where('id', $user)->exists(), 404);

        if (Schema::hasColumn('users', 'status')) {
            DB::table('users')->where('id', $user)->update([
                'status' => 'active',
                'updated_at' => now(),
            ]);
        }

        $this->log(
            $request,
            'user.activated',
            "Compte client #{$user} réactivé",
            $user,
        );

        return back()->with('success', 'Compte réactivé.');
    }

    /**
     * @param array<int, string> $wantedColumns
     * @return array<int, array<string, mixed>>
     */
    private function latestRowsForUser(
        string $table,
        int $userId,
        array $wantedColumns,
        int $limit,
    ): array {
        if (
            ! Schema::hasTable($table)
            || ! Schema::hasColumn($table, 'user_id')
        ) {
            return [];
        }

        $columns = array_values(array_filter(
            $wantedColumns,
            fn (string $column): bool => Schema::hasColumn($table, $column),
        ));

        if (! in_array('id', $columns, true)) {
            $columns[] = 'id';
        }

        return DB::table($table)
            ->select($columns)
            ->where('user_id', $userId)
            ->latest(
                Schema::hasColumn($table, 'created_at')
                    ? 'created_at'
                    : 'id',
            )
            ->limit($limit)
            ->get()
            ->map(fn (object $row): array => (array) $row)
            ->all();
    }

    private function log(
        Request $request,
        string $action,
        string $description,
        int $targetUserId,
    ): void {
        if (! Schema::hasTable('admin_logs')) {
            return;
        }

        $payload = [];

        foreach ([
            'action' => $action,
            'description' => $description,
            'user_id' => $request->user()?->id,
            'target_user_id' => $targetUserId,
            'ip_address' => $request->ip(),
            'user_agent' => $request->userAgent(),
            'created_at' => now(),
            'updated_at' => now(),
        ] as $column => $value) {
            if (Schema::hasColumn('admin_logs', $column)) {
                $payload[$column] = $value;
            }
        }

        if ($payload !== []) {
            DB::table('admin_logs')->insert($payload);
        }
    }
}
