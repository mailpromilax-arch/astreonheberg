<?php

declare(strict_types=1);

namespace App\Http\Controllers\Admin;

use App\Services\Mail\AstreonMailer;
use App\Http\Controllers\Controller;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;
use Illuminate\Support\Facades\Storage;
use Inertia\Inertia;
use Inertia\Response;
use Symfony\Component\HttpFoundation\StreamedResponse;

final class TicketController extends Controller
{
    public function index(Request $request): Response
    {
        $search = trim((string) $request->string('search'));
        $status = trim((string) $request->string('status'));
        $priority = trim((string) $request->string('priority'));
        $assignment = trim((string) $request->string('assignment'));

        $query = DB::table('tickets');

        if ($search !== '') {
            $query->where(function ($builder) use ($search): void {
                $builder
                    ->where('subject', 'like', "%{$search}%")
                    ->orWhere('id', $search);

                if (Schema::hasTable('users')) {
                    $builder->orWhereExists(function ($sub) use ($search): void {
                        $sub->selectRaw('1')
                            ->from('users')
                            ->whereColumn('users.id', 'tickets.user_id')
                            ->where(function ($userQuery) use ($search): void {
                                $userQuery
                                    ->where('users.name', 'like', "%{$search}%")
                                    ->orWhere('users.email', 'like', "%{$search}%");
                            });
                    });
                }
            });
        }

        if ($status !== '') {
            $query->where('status', $status);
        }

        if ($priority !== '') {
            $query->where('priority', $priority);
        }

        if ($assignment === 'mine') {
            $query->where('assigned_to', $request->user()->id);
        } elseif ($assignment === 'unassigned') {
            $query->whereNull('assigned_to');
        }

        $tickets = $query
            ->latest('updated_at')
            ->paginate(20)
            ->withQueryString();

        $userIds = collect($tickets->items())
            ->flatMap(fn (object $ticket): array => [
                $ticket->user_id,
                $ticket->assigned_to,
            ])
            ->filter()
            ->unique()
            ->values();

        $users = Schema::hasTable('users')
            ? DB::table('users')
                ->whereIn('id', $userIds)
                ->get(['id', 'name', 'email'])
                ->keyBy('id')
            : collect();

        $tickets->through(function (object $ticket) use ($users): array {
            $customer = $users->get($ticket->user_id);
            $assignee = $ticket->assigned_to
                ? $users->get($ticket->assigned_to)
                : null;

            return [
                'id' => $ticket->id,
                'subject' => $ticket->subject,
                'priority' => $ticket->priority,
                'status' => $ticket->status,
                'waiting_for' => $ticket->waiting_for,
                'created_at' => $ticket->created_at,
                'updated_at' => $ticket->updated_at,
                'customer' => $customer
                    ? [
                        'id' => $customer->id,
                        'name' => $customer->name,
                        'email' => $customer->email,
                    ]
                    : null,
                'assignee' => $assignee
                    ? [
                        'id' => $assignee->id,
                        'name' => $assignee->name,
                    ]
                    : null,
            ];
        });

        return Inertia::render('admin/tickets/index', [
            'tickets' => $tickets,
            'filters' => [
                'search' => $search,
                'status' => $status,
                'priority' => $priority,
                'assignment' => $assignment,
            ],
            'counts' => [
                'open' => DB::table('tickets')
                    ->whereNotIn('status', ['closed'])
                    ->count(),
                'unassigned' => DB::table('tickets')
                    ->whereNotIn('status', ['closed'])
                    ->whereNull('assigned_to')
                    ->count(),
                'mine' => DB::table('tickets')
                    ->whereNotIn('status', ['closed'])
                    ->where('assigned_to', $request->user()->id)
                    ->count(),
                'high' => DB::table('tickets')
                    ->whereNotIn('status', ['closed'])
                    ->where('priority', 'high')
                    ->count(),
            ],
        ]);
    }

    public function show(int $ticket): Response
    {
        $record = DB::table('tickets')->where('id', $ticket)->first();
        abort_if($record === null, 404);

        $customer = DB::table('users')
            ->where('id', $record->user_id)
            ->first(['id', 'name', 'email']);

        $assignee = $record->assigned_to
            ? DB::table('users')
                ->where('id', $record->assigned_to)
                ->first(['id', 'name', 'email'])
            : null;

        $replies = DB::table('ticket_replies')
            ->where('ticket_id', $ticket)
            ->orderBy('created_at')
            ->get();

        $replyUserIds = $replies
            ->pluck('user_id')
            ->filter()
            ->unique()
            ->values();

        $authors = DB::table('users')
            ->whereIn('id', $replyUserIds)
            ->get(['id', 'name', 'email'])
            ->keyBy('id');

        $attachments = DB::table('ticket_attachments')
            ->where('ticket_id', $ticket)
            ->get()
            ->groupBy('ticket_reply_id');

        $messages = $replies->map(function (object $reply) use ($authors, $attachments): array {
            $author = $reply->user_id
                ? $authors->get($reply->user_id)
                : null;

            return [
                'id' => $reply->id,
                'message' => $reply->message,
                'is_admin' => (bool) $reply->is_admin,
                'created_at' => $reply->created_at,
                'author' => $author
                    ? [
                        'id' => $author->id,
                        'name' => $author->name,
                        'email' => $author->email,
                    ]
                    : null,
                'attachments' => $attachments
                    ->get($reply->id, collect())
                    ->map(fn (object $file): array => [
                        'id' => $file->id,
                        'name' => $file->original_name,
                        'mime_type' => $file->mime_type,
                        'size' => $file->size,
                    ])
                    ->values()
                    ->all(),
            ];
        })->all();

        return Inertia::render('admin/tickets/show', [
            'ticket' => [
                'id' => $record->id,
                'subject' => $record->subject,
                'priority' => $record->priority,
                'status' => $record->status,
                'waiting_for' => $record->waiting_for,
                'assigned_to' => $record->assigned_to,
                'created_at' => $record->created_at,
                'updated_at' => $record->updated_at,
                'closed_at' => $record->closed_at,
            ],
            'customer' => $customer,
            'assignee' => $assignee,
            'messages' => $messages,
        ]);
    }

    public function assign(Request $request, int $ticket): RedirectResponse
    {
        $record = DB::table('tickets')->where('id', $ticket)->first();
        abort_if($record === null, 404);
        abort_if($record->status === 'closed', 422, 'Ticket fermé.');

        DB::table('tickets')->where('id', $ticket)->update([
            'assigned_to' => $request->user()->id,
            'status' => 'assigned',
            'updated_at' => now(),
        ]);

        $this->log(
            $request,
            'ticket.assigned',
            "Ticket #{$ticket} pris en charge",
            $ticket,
        );

        return back()->with('success', 'Ticket attribué à votre compte.');
    }

    public function reply(Request $request, int $ticket): RedirectResponse
    {
        $record = DB::table('tickets')->where('id', $ticket)->first();
        abort_if($record === null, 404);
        abort_if($record->status === 'closed', 422, 'Ticket fermé.');
        abort_if(
            (int) $record->assigned_to !== (int) $request->user()->id,
            403,
            'Vous devez prendre le ticket avant de répondre.',
        );

        $validated = $request->validate([
            'message' => ['required', 'string', 'max:20000'],
            'attachments' => ['nullable', 'array', 'max:5'],
            'attachments.*' => [
                'file',
                'max:10240',
                'mimes:jpg,jpeg,png,gif,webp,pdf,txt,log,zip,rar,7z,doc,docx,xls,xlsx',
            ],
        ]);

        $replyId = DB::table('ticket_replies')->insertGetId([
            'ticket_id' => $ticket,
            'user_id' => $request->user()->id,
            'is_admin' => true,
            'message' => $validated['message'],
            'created_at' => now(),
            'updated_at' => now(),
        ]);

        foreach ($request->file('attachments', []) as $file) {
            $path = $file->store("tickets/{$ticket}", 'public');

            DB::table('ticket_attachments')->insert([
                'ticket_id' => $ticket,
                'ticket_reply_id' => $replyId,
                'user_id' => $request->user()->id,
                'disk' => 'public',
                'path' => $path,
                'original_name' => $file->getClientOriginalName(),
                'mime_type' => $file->getClientMimeType(),
                'size' => $file->getSize(),
                'created_at' => now(),
                'updated_at' => now(),
            ]);
        }

        DB::table('tickets')->where('id', $ticket)->update([
            'status' => 'waiting_client',
            'waiting_for' => 'client',
            'last_reply_by' => $request->user()->id,
            'last_replied_at' => now(),
            'updated_at' => now(),
        ]);

        $this->log(
            $request,
            'ticket.replied',
            "Réponse administrateur envoyée sur le ticket #{$ticket}",
            $ticket,
        );

        app(AstreonMailer::class)->user(
            (int) $record->user_id,
            "Nouvelle réponse au ticket #{$ticket}",
            'ASSISTANCE ASTREON',
            'Le support vous a répondu',
            "{$request->user()->name} a répondu à votre ticket.",
            ['Connectez-vous à votre espace client pour lire le message et répondre.'],
            'Lire la réponse',
            url("/client/support/{$ticket}"),
            null,
            'info',
            ['Ticket' => "#{$ticket}", 'Répondu par' => $request->user()->name],
        );

        return back()->with('success', 'Réponse envoyée au client.');
    }

    public function close(Request $request, int $ticket): RedirectResponse
    {
        $record = DB::table('tickets')->where('id', $ticket)->first();
        abort_if($record === null, 404);

        DB::table('tickets')->where('id', $ticket)->update([
            'status' => 'closed',
            'closed_at' => now(),
            'updated_at' => now(),
        ]);

        $this->log(
            $request,
            'ticket.closed',
            "Ticket #{$ticket} fermé",
            $ticket,
        );

        app(AstreonMailer::class)->user(
            (int) $record->user_id,
            "Ticket #{$ticket} fermé",
            'ASSISTANCE ASTREON',
            'Votre ticket a été fermé',
            "{$request->user()->name} a fermé votre ticket.",
            ['Vous pourrez consulter l’historique depuis votre espace client.'],
            'Consulter le ticket',
            url("/client/support/{$ticket}"),
            null,
            'info',
            ['Ticket' => "#{$ticket}", 'Fermé par' => $request->user()->name],
        );

        return back()->with('success', 'Ticket fermé.');
    }

    public function reopen(Request $request, int $ticket): RedirectResponse
    {
        $record = DB::table('tickets')->where('id', $ticket)->first();
        abort_if($record === null, 404);

        DB::table('tickets')->where('id', $ticket)->update([
            'status' => $record->assigned_to ? 'assigned' : 'open',
            'waiting_for' => 'admin',
            'closed_at' => null,
            'updated_at' => now(),
        ]);

        $this->log(
            $request,
            'ticket.reopened',
            "Ticket #{$ticket} rouvert",
            $ticket,
        );

        app(AstreonMailer::class)->user(
            (int) $record->user_id,
            "Ticket #{$ticket} rouvert",
            'ASSISTANCE ASTREON',
            'Votre ticket a été rouvert',
            "{$request->user()->name} a rouvert votre ticket.",
            ['La conversation peut reprendre depuis votre espace client.'],
            'Consulter le ticket',
            url("/client/support/{$ticket}"),
            null,
            'info',
            ['Ticket' => "#{$ticket}", 'Rouvert par' => $request->user()->name],
        );

        return back()->with('success', 'Ticket rouvert.');
    }

    public function attachment(int $attachment): StreamedResponse
    {
        $file = DB::table('ticket_attachments')
            ->where('id', $attachment)
            ->first();

        abort_if($file === null, 404);
        abort_unless(Storage::disk($file->disk)->exists($file->path), 404);

        return Storage::disk($file->disk)->download(
            $file->path,
            $file->original_name,
        );
    }

    private function log(
        Request $request,
        string $action,
        string $description,
        int $ticketId,
    ): void {
        if (! Schema::hasTable('admin_logs')) {
            return;
        }

        $payload = [];

        foreach ([
            'action' => $action,
            'description' => $description,
            'user_id' => $request->user()?->id,
            'ticket_id' => $ticketId,
            'ip_address' => $request->ip(),
            'user_agent' => $request->userAgent(),
            'created_at' => now(),
            'updated_at' => now(),
        ] as $column => $value) {
            if (Schema::hasColumn('admin_logs', $column)) {
                $payload[$column] = $value;
            }
        }

        if ($payload !== []) {
            DB::table('admin_logs')->insert($payload);
        }
    }
}
